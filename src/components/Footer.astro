---
const today = new Date();
---

<footer>
	<p class="copyright">&copy; {today.getFullYear()} Dustin Martinka. All rights reserved.</p>
	<p class="credits-line">
		Made using AI and my 🧠 and ❤️ &mdash;
		<button class="credits-link" id="open-credits">Full credits</button>
	</p>
</footer>

<!-- Credits overlay (position: fixed — DOM placement doesn't affect layout) -->
<div class="credits-overlay" id="credits-overlay" role="dialog" aria-modal="true" aria-label="Full credits">

	<!-- Cursor orb -->
	<div class="cursor-orb" id="cursor-orb" aria-hidden="true"></div>

	<!-- Parallax ambient orbs -->
	<div class="ambient-orbs" aria-hidden="true">
		<div class="ambient-orb" data-speed="0.04" style="width:320px;height:320px;top:10%;left:8%;background:#C9A96E;"></div>
		<div class="ambient-orb" data-speed="0.07" style="width:200px;height:200px;top:60%;left:75%;background:#f2ede8;"></div>
		<div class="ambient-orb" data-speed="0.03" style="width:260px;height:260px;top:75%;left:15%;background:#C9A96E;"></div>
		<div class="ambient-orb" data-speed="0.06" style="width:160px;height:160px;top:20%;left:80%;background:#f2ede8;"></div>
		<div class="ambient-orb" data-speed="0.05" style="width:220px;height:220px;top:45%;left:50%;background:#C9A96E;"></div>
	</div>

	<button class="credits-close" id="credits-close" aria-label="Close credits">&times;</button>
	<div class="credits-scroll-wrap">
		<div class="credits-content" id="credits-content">

			<p class="credits-section-label">AI &amp; Development</p>

			<p class="credits-name">Claude</p>
			<p class="credits-sub">Anthropic</p>
			<p class="credits-role">Strategy, writing, design feedback, and creative direction.</p>

			<p class="credits-name">Claude Code</p>
			<p class="credits-sub">Anthropic</p>
			<p class="credits-role">The VS Code extension. Connected to the codebase, wrote the code, ran the builds.</p>

			<p class="credits-section-label">Design &amp; Craft</p>

			<p class="credits-name">Figma</p>
			<p class="credits-role">Design and prototyping.</p>

			<p class="credits-name">Figma Make</p>
			<p class="credits-sub">with Nano Banana</p>
			<p class="credits-role">Design system architecture and case study presentations.</p>

			<p class="credits-name">Claude Design</p>
			<p class="credits-sub">Anthropic</p>
			<p class="credits-role">Design system build-out and case study deck.</p>

			<p class="credits-section-label">Imagery &amp; Illustration</p>

			<p class="credits-name">Redraft</p>
			<p class="credits-role">AI image styling, connected via DustAIn.</p>

			<p class="credits-name">Gemini &amp; Nano Banana</p>
			<p class="credits-sub">Google</p>
			<p class="credits-role">Portrait illustrations from photo.</p>

			<p class="credits-name">Canva</p>
			<p class="credits-role">Portfolio card illustrations.</p>

			<p class="credits-section-label">Inspiration</p>

			<p class="credits-name">Variant</p>
			<p class="credits-role">Layout inspiration and fresh ideas.</p>

			<p class="credits-section-label">Built On</p>

			<p class="credits-name">Astro</p>
			<p class="credits-role">Static site framework.</p>

			<div class="credits-divider"></div>

			<p class="credits-finale">A Dustin Martinka Production</p>

		</div>
	</div>
</div>

<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: #ffffff;
		color: rgba(43, 43, 43, 0.5);
		text-align: center;
		font-family: var(--font-sans);
		font-size: 13px;
	}

	.copyright {
		margin: 0 0 8px;
	}

	.credits-line {
		margin: 0;
		font-size: 13px;
		color: rgba(43, 43, 43, 0.5);
	}

	.credits-link {
		background: none;
		border: none;
		border-bottom: 1px solid rgba(201, 169, 110, 0.35);
		padding: 0 0 1px;
		font-family: var(--font-sans);
		font-size: 13px;
		color: #C9A96E;
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.credits-link:hover {
		color: #d9bc89;
		border-color: rgba(201, 169, 110, 0.7);
	}

	/* ── OVERLAY ── */
	.credits-overlay {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 500;
		background: #201e1b;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.7s ease;
	}

	.credits-overlay.is-visible {
		display: block;
	}

	.credits-overlay.is-open {
		opacity: 1;
		pointer-events: all;
	}

	.credits-close {
		position: absolute;
		top: 32px;
		right: 40px;
		z-index: 10;
		background: none;
		border: none;
		font-size: 32px;
		line-height: 1;
		color: rgba(242, 237, 232, 0.35);
		cursor: pointer;
		transition: color 0.2s ease;
		padding: 0;
	}

	.credits-close:hover {
		color: #f2ede8;
	}

	/* ── CURSOR ORB ── */
	.cursor-orb {
		position: absolute;
		width: 280px;
		height: 280px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(201,169,110,0.55) 0%, rgba(201,169,110,0) 70%);
		filter: blur(24px);
		mix-blend-mode: screen;
		pointer-events: none;
		transform: translate(-50%, -50%);
		left: 50%;
		top: 50%;
		z-index: 2;
		transition: opacity 0.4s ease;
		opacity: 0;
	}

	.credits-overlay.is-open .cursor-orb {
		opacity: 1;
	}

	/* ── AMBIENT PARALLAX ORBS ── */
	.ambient-orbs {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 1;
	}

	.ambient-orb {
		position: absolute;
		border-radius: 50%;
		opacity: 0.08;
		filter: blur(60px);
		mix-blend-mode: screen;
		will-change: transform;
	}

	/* ── SCROLL MECHANICS ── */
	.credits-scroll-wrap {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}

	.credits-content {
		width: 100%;
		max-width: 560px;
		margin: 0 auto;
		padding: 0 40px 0;
		text-align: center;
		transform: translateY(100vh);
	}

	/* scroll driven by JS — no CSS animation */

	/* ── CREDITS TYPOGRAPHY ── */
	.credits-section-label {
		font-family: var(--font-sans);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #C9A96E;
		margin: 80px 0 36px;
	}

	.credits-name {
		font-family: var(--font-serif);
		font-weight: 300;
		font-size: clamp(28px, 4vw, 44px);
		line-height: 1.15;
		color: #f2ede8;
		margin: 0 0 6px;
	}

	.credits-sub {
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(242, 237, 232, 0.35);
		margin: 0 0 14px;
	}

	.credits-role {
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.65;
		color: rgba(242, 237, 232, 0.5);
		margin: 0 0 56px;
	}

	.credits-divider {
		width: 40px;
		height: 1px;
		background: rgba(242, 237, 232, 0.15);
		margin: 80px auto 64px;
	}

	.credits-finale {
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(242, 237, 232, 0.3);
		margin: 0 0 240px;
	}

	@media (max-width: 600px) {
		.credits-close {
			top: 20px;
			right: 24px;
		}

		.credits-content {
			padding: 0 32px;
		}
	}
</style>

<script>
	const overlay  = document.getElementById('credits-overlay');
	const openBtn  = document.getElementById('open-credits');
	const closeBtn = document.getElementById('credits-close');
	const content  = document.getElementById('credits-content') as HTMLElement | null;
	const cursorOrb   = document.getElementById('cursor-orb') as HTMLElement | null;
	const ambientOrbs = Array.from(document.querySelectorAll<HTMLElement>('.ambient-orb'));

	// ── CURSOR ORB (lerp follow) ──
	let mouseX = window.innerWidth / 2;
	let mouseY = window.innerHeight / 2;
	let orbX = mouseX, orbY = mouseY;

	function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

	// ── CREDITS SCROLL (JS-driven) ──
	const SCROLL_SPEED = 0.6; // px per frame
	const RESUME_DELAY = 1800; // ms after wheel stops
	let creditsY    = 0;
	let autoScroll  = true;
	let mainRaf     = 0;
	let resumeTimer = 0;

	function tick() {
		// Orb lerp
		orbX = lerp(orbX, mouseX, 0.08);
		orbY = lerp(orbY, mouseY, 0.08);
		if (cursorOrb) {
			cursorOrb.style.left = orbX + 'px';
			cursorOrb.style.top  = orbY + 'px';
		}

		// Credits scroll
		if (autoScroll) creditsY -= SCROLL_SPEED;
		if (content) content.style.transform = `translateY(${creditsY}px)`;

		mainRaf = requestAnimationFrame(tick);
	}

	// ── PARALLAX ──
	function onMouseMove(e: MouseEvent) {
		mouseX = e.clientX;
		mouseY = e.clientY;
		const cx = window.innerWidth / 2;
		const cy = window.innerHeight / 2;
		const dx = e.clientX - cx;
		const dy = e.clientY - cy;
		ambientOrbs.forEach(orb => {
			const s = parseFloat(orb.dataset.speed || '0.05');
			orb.style.transform = `translate(${dx * s}px, ${dy * s}px)`;
		});
	}

	// ── SCROLL WHEEL HIJACK ──
	function onWheel(e: WheelEvent) {
		e.preventDefault();
		autoScroll = false;
		creditsY -= e.deltaY * 0.8;
		clearTimeout(resumeTimer);
		resumeTimer = window.setTimeout(() => { autoScroll = true; }, RESUME_DELAY);
	}

	overlay?.addEventListener('mousemove', onMouseMove);
	overlay?.addEventListener('wheel', onWheel, { passive: false });

	// ── OPEN / CLOSE ──
	function openCredits() {
		creditsY   = window.innerHeight;
		autoScroll = true;
		if (content) content.style.transform = `translateY(${creditsY}px)`;
		overlay?.classList.add('is-visible');
		requestAnimationFrame(() => requestAnimationFrame(() => {
			overlay?.classList.add('is-open');
		}));
		document.body.style.overflow = 'hidden';
		mainRaf = requestAnimationFrame(tick);
	}

	function closeCredits() {
		overlay?.classList.remove('is-open');
		document.body.style.overflow = '';
		cancelAnimationFrame(mainRaf);
		clearTimeout(resumeTimer);
		overlay?.addEventListener('transitionend', () => {
			overlay?.classList.remove('is-visible');
		}, { once: true });
	}

	openBtn?.addEventListener('click', openCredits);
	closeBtn?.addEventListener('click', closeCredits);
	document.addEventListener('keydown', e => {
		if (e.key === 'Escape' && overlay?.classList.contains('is-open')) closeCredits();
	});
	overlay?.addEventListener('click', e => {
		if (e.target === overlay) closeCredits();
	});
</script>
