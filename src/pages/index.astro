---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Accomplishments from '../components/Accomplishments.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <section class="hero">
      <!-- Orbs -->
      <div class="hero-orbs" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-4"></div>
        <div class="orb orb-5"></div>
        <div class="orb orb-6"></div>
        <div class="orb orb-7"></div>
        <div class="orb orb-8"></div>
        <div class="orb orb-9"></div>
        <div class="orb orb-10"></div>
        <div class="orb orb-11"></div>
        <div class="orb orb-12"></div>
        <div class="orb orb-15"></div>
        <div class="orb orb-16"></div>
        <div class="orb orb-18"></div>
        <div class="orb orb-19"></div>
        <div class="orb orb-20"></div>
      </div>

      <!-- Left: Text -->
      <div class="hero-text">
        <h1 class="hero-headline">
          <span class="name-line">Hi, I'm Dustin</span>
          <span class="statement">
            I <em class="highlight">grow</em> design cultures. I <em class="highlight">sharpen</em> the craft. I still <em class="highlight">make</em> things.
          </span>
        </h1>
        <div class="hero-divider"></div>
        <p class="hero-meta">Available for new opportunities</p>
      </div>

      <!-- Right: Photo -->
      <div class="hero-photo-wrap">
        <img
          class="hero-photo"
          src="/gold-dustin-no-orb.png"
          alt="Dustin Martinka"
        />
      </div>
    </section>

    <main>
      <section class="about-section">
        <div class="about-inner">
          <h2 class="about-headline">
            Great work starts with a culture that makes it possible.
          </h2>
          <div class="about-body">
            <p>I've spent 20+ years at T-Mobile, MoxiWorks, and Microsoft designing product and growing design teams from the inside out. Getting the craft sharper, the collaboration tighter, and the work closer to what users actually need. I stay close enough to the making that I know the difference between good direction and the real thing.</p>
            <p>I've led through ambiguity, reorgs, and high-pressure launches by bringing clarity to complex problem spaces and keeping the work grounded in real users and real business outcomes. I'm calm under pressure, direct in feedback, and invested in helping designers grow into the next version of themselves.</p>
            <p>No ego. Thoughtful direction. I don't always have all the answers, but I'll ask the right questions and help the team find the path forward.</p>
          </div>
        </div>
      </section>
    </main>

    <Accomplishments />

    <Footer />
  </body>
</html>

<style>
  :root {
    --bg: #201e1b;
    --fg: #f2ede8;
    --fg-mid: rgba(242, 237, 232, 0.7);
    --fg-dim: rgba(242, 237, 232, 0.45);
  }

  body {
    background-color: var(--bg);
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    position: relative;
    overflow: hidden;
    background: var(--bg);
  }

  /* ── LEFT COLUMN ── */
  .hero-text {
    padding: 140px 0px 80px 56px;
    position: relative;
    z-index: 10;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(52px, 6.5vw, 96px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-wrap: pretty;
    margin: 0 0 0 0;
  }

  .hero-headline .name-line {
    font-weight: 400;
    font-style: normal;
    font-size: 24px;
    display: block;
    margin-bottom: 10px;
    letter-spacing: 0;
  }

  .hero-headline .statement {
    display: block;
    color: #ffffff;
  }

  .hero-headline .statement span {
    display: block;
    color: var(--fg-mid);
  }

  .hero-headline .highlight {
    color: #C9A96E;
    font-style: normal;
  }

  .hero-divider {
    width: 40px;
    height: 1px;
    background: var(--fg-dim);
    margin: 40px 0;
  }

  .hero-meta {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.05em;
    color: var(--fg-dim);
    text-transform: uppercase;
    margin: 0;
  }

  /* ── RIGHT COLUMN — PHOTO ── */
  .hero-photo-wrap {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero-photo {
    filter: brightness(0.9);
  }

  /* Gradient: fade photo into bg on left, bottom, and slightly top */
  .hero-photo-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(to right, var(--bg) 0%, transparent 35%),
      linear-gradient(to top, var(--bg) 0%, transparent 22%),
      linear-gradient(to bottom, var(--bg) 0%, transparent 10%);
    pointer-events: none;
  }

  /* Right edge vignette */
  .hero-photo-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to left, var(--bg) 0%, transparent 20%);
    pointer-events: none;
  }

  /* ── ORBS ── */
  .hero-orbs {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.4) 25%, black 45%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.4) 25%, black 45%);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: screen;
  }

  /* Persistent pulse — big opacity swing */
  @keyframes pulse-a { from { opacity: 0.15; transform: scale(1);    } to { opacity: 0.85; transform: scale(1.1);  } }
  @keyframes pulse-b { from { opacity: 0.1;  transform: scale(1);    } to { opacity: 0.75; transform: scale(1.12); } }
  @keyframes pulse-c { from { opacity: 0.2;  transform: scale(1);    } to { opacity: 0.9;  transform: scale(1.08); } }
  @keyframes pulse-d { from { opacity: 0.05; transform: scale(1);    } to { opacity: 0.5;  transform: scale(1.15); } }

  /* Appear / disappear — fades to zero on both ends */
  @keyframes appear-a {
    0%   { opacity: 0;    transform: scale(0.85); }
    25%  { opacity: 0.75; transform: scale(1.05); }
    75%  { opacity: 0.75; transform: scale(1.05); }
    100% { opacity: 0;    transform: scale(0.85); }
  }
  @keyframes appear-b {
    0%   { opacity: 0;   transform: scale(0.9); }
    35%  { opacity: 0.6; transform: scale(1);   }
    65%  { opacity: 0.6; transform: scale(1);   }
    100% { opacity: 0;   transform: scale(0.9); }
  }

  /* Large orbs */
  .orb-1  { width: 66px;  height: 66px;  top: 7%;  left: 54%; background: #f2ede8; filter: blur(5px);  animation: pulse-a 3.8s ease-in-out infinite alternate; animation-delay: 0s;    }
  .orb-2  { width: 72px;  height: 72px;  top: 1%;  left: 84%; background: #C9A96E; filter: blur(6px);  animation: pulse-b 4.6s ease-in-out infinite alternate; animation-delay: 0.8s;  }

  /* Medium orbs */
  .orb-4  { width: 48px;  height: 48px;  top: 5%;  left: 44%; background: #C9A96E; filter: blur(7px);  animation: pulse-b 4.2s ease-in-out infinite alternate; animation-delay: 0.3s;  }
  .orb-5  { width: 42px;  height: 42px;  top: 21%; left: 57%; background: #f2ede8; filter: blur(7px);  animation: pulse-c 5.6s ease-in-out infinite alternate; animation-delay: 2.1s;  }
  .orb-6  { width: 52px;  height: 52px;  top: 3%;  left: 81%; background: #f2ede8; filter: blur(6px);  animation: pulse-a 4.4s ease-in-out infinite alternate; animation-delay: 1.0s;  }
  .orb-7  { width: 36px;  height: 36px;  top: 16%; left: 41%; background: #C9A96E; filter: blur(7px);  animation: pulse-b 5.8s ease-in-out infinite alternate; animation-delay: 0.5s;  }
  .orb-8  { width: 44px;  height: 44px;  top: 9%;  left: 87%; background: #C9A96E; filter: blur(6px);  animation: pulse-c 4.0s ease-in-out infinite alternate; animation-delay: 1.7s;  }

  /* Left bleed — small, blurry, receding into background */
  .orb-9  { width: 28px;  height: 28px;  top: 10%; left: 24%; background: #f2ede8; filter: blur(10px); animation: pulse-d 5.8s ease-in-out infinite alternate; animation-delay: 0.6s;  }
  .orb-10 { width: 20px;  height: 20px;  top: 5%;  left: 14%; background: #C9A96E; filter: blur(12px); animation: pulse-d 7.0s ease-in-out infinite alternate; animation-delay: 1.2s;  }
  .orb-11 { width: 24px;  height: 24px;  top: 19%; left: 31%; background: #f2ede8; filter: blur(9px);  animation: pulse-d 6.2s ease-in-out infinite alternate; animation-delay: 2.4s;  }

  /* Small background orbs — blurry, receding */
  .orb-12 { width: 16px;  height: 16px;  top: 4%;  left: 67%; background: #f2ede8; filter: blur(8px);  animation: pulse-c 3.4s ease-in-out infinite alternate; animation-delay: 0.9s;  }
  .orb-15 { width: 12px;  height: 12px;  top: 15%; left: 51%; background: #C9A96E; filter: blur(10px); animation: pulse-c 4.1s ease-in-out infinite alternate; animation-delay: 2.8s;  }

  /* Appear / disappear orbs */
  .orb-16 { width: 55px;  height: 55px;  top: 6%;  left: 59%; background: #f2ede8; filter: blur(2px);  animation: appear-a 9.0s ease-in-out infinite; animation-delay: 0s;    }
  .orb-18 { width: 66px;  height: 66px;  top: 2%;  left: 48%; background: #C9A96E; filter: blur(2px);  animation: appear-a 13.0s ease-in-out infinite; animation-delay: 6.0s;  }
  .orb-19 { width: 30px;  height: 30px;  top: 4%;  left: 91%; background: #f2ede8; filter: blur(4px);  animation: appear-b 8.0s  ease-in-out infinite; animation-delay: 1.8s;  }
  .orb-20 { width: 45px;  height: 45px;  top: 11%; left: 93%; background: #f2ede8; filter: blur(2px);  animation: appear-a 10.5s ease-in-out infinite; animation-delay: 5.0s;  }

  /* ── GRAIN ── */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    mix-blend-mode: overlay;
    opacity: 0.5;
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/></filter><rect width='300' height='300' filter='url(%23n)' opacity='1'/></svg>");
    background-repeat: repeat;
    background-size: 300px 300px;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-headline { animation: fadeUp 0.9s ease both; animation-delay: 0.25s; }
  .hero-divider  { animation: fadeUp 0.8s ease both; animation-delay: 0.55s; }
  .hero-meta     { animation: fadeUp 0.8s ease both; animation-delay: 0.65s; }
  .hero-photo    { animation: fadeUp 1.1s ease both; animation-delay: 0.15s; }

  /* Override global main constraint for homepage */
  main {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  /* ── ABOUT SECTION ── */
  .about-section {
    background: #F5F4F0;
    width: 100%;
  }

  .about-inner {
    max-width: 860px;
    margin: 0 auto;
    padding: 120px 56px;
  }

  .about-headline {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #2b2b2b;
    margin: 0 0 56px 0;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .about-body p {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.7;
    color: rgba(43, 43, 43, 0.7);
    margin: 0;
  }


  /* ── RESPONSIVE ── */
  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
    }

    .hero-text {
      padding: 140px 32px 80px;
      grid-row: 1;
      grid-column: 1;
      position: relative;
      z-index: 10;
    }

    .hero-photo-wrap {
      position: absolute;
      inset: 0;
      height: 100%;
      grid-row: unset;
    }

    .hero-photo {
      filter: brightness(0.35) saturate(0.8);
    }

    .hero-photo-wrap::before {
      background:
        linear-gradient(to bottom, var(--bg) 0%, transparent 20%),
        linear-gradient(to top, var(--bg) 0%, transparent 30%),
        rgba(32, 30, 27, 0.55);
    }

    /* Hide orbs that fall over the illustration on mobile */
    .orb-1, .orb-4, .orb-5, .orb-7, .orb-9, .orb-10, .orb-11, .orb-15, .orb-18 {
      display: none;
    }

    .about-body p {
      font-size: 17px;
    }
  }
</style>
