---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';

const allExperiments = (await getCollection('experiments')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Pre-compute hover rotation: move 3deg toward 0, never cross it.
function hoverRot(rot: string): string {
  const deg = parseFloat(rot);
  const delta = 3;
  const hover = deg > 0 ? Math.max(0, deg - delta) : Math.min(0, deg + delta);
  return `${hover}deg`;
}

// 14 card positions. 5 top, 4 middle, 5 bottom.
// Rotations alternate direction.
const cardDefs = [
  // Row 1 — top of spread, 5 cards
  { top: '4%',  left: '10%', rot: '-5deg', slug: 'onboarding-gpt' },
  { top: '2%',  left: '25%', rot: '3deg',  slug: 'mood-uplifter' },
  { top: '5%',  left: '40%', rot: '-2deg', slug: 'dustain' },
  { top: '2%',  left: '55%', rot: '6deg',  slug: 'interview-framework' },
  { top: '4%',  left: '70%', rot: '-4deg', slug: 'layoff-advocacy' },
  // Row 2 — middle, 4 cards, centered
  { top: '30%', left: '20%', rot: '4deg',  slug: 'weekly-wrapup' },
  { top: '27%', left: '35%', rot: '-6deg', slug: 'design-brief' },
  { top: '31%', left: '50%', rot: '2deg',  slug: 'tmobile-nav-unification' },
  { top: '28%', left: '65%', rot: '-3deg', slug: 'competency-assessment' },
  // Row 3 — bottom, 5 cards
  { top: '55%', left: '10%', rot: '3deg',  slug: 'general-assembly' },
  { top: '52%', left: '25%', rot: '-4deg', slug: 'marketplace-fridge' },
  { top: '56%', left: '40%', rot: '6deg',  slug: 'tmobile-workshop' },
  { top: '53%', left: '55%', rot: '-2deg', slug: 'elvtr-certification' },
  { top: '55%', left: '70%', rot: '5deg',  slug: 'frankfurt-barcamp' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Experiments — Dustin Martinka"
      description="Things I've built, tried, and learned from. Part playground, part proof of work."
    />
  </head>
  <body>
    <Header forceScrolled={true} />

    <div class="experiments-stage">
      <p class="stage-label">These are things I've built, tried, and learned from. Not all of them worked. That's the point.</p>
      <div class="card-spread" id="card-spread">
        {cardDefs.map((def, i) => {
          const exp = def.slug
            ? allExperiments.find(e => e.id === def.slug)
            : null;
          const isPlaceholder = !exp;

          return (
            <div
              class={`exp-card${isPlaceholder ? ' is-placeholder' : ''}`}
              style={`--rot: ${def.rot}; --hover-rot: ${hoverRot(def.rot)}; top: ${def.top}; left: ${def.left}; opacity: 0;`}
              data-index={i}
              role="button"
              tabindex="0"
              aria-expanded="false"
            >
              <p class="card-intro">The time I...</p>
              <h2 class="card-headline">
                {exp ? exp.data.cardHeadline ?? exp.data.title : 'coming soon'}
              </h2>
              <div class="card-detail" aria-hidden="true">
                {exp ? (
                  <>
                    <p class="card-detail-text">{exp.data.cardDetail ?? exp.data.description}</p>
                    {exp.data.fullStory !== false && (
                      <a href={`/experiments/${exp.id}/`} class="card-link">Full story →</a>
                    )}
                  </>
                ) : (
                  <p class="card-oven">still in the oven.</p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </body>
</html>

<style>
  html, body {
    overflow: hidden;
    height: 100%;
    margin: 0;
  }

  .experiments-stage {
    height: 100dvh;
    padding-top: 72px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: #201e1b;
    overflow: hidden;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .stage-label {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(16px, 1.6vw, 22px);
    color: rgba(242, 237, 232, 0.9);
    padding: 28px 0 30px;
    margin: 0;
    flex-shrink: 0;
    letter-spacing: -0.01em;
    text-align: center;
    animation: fadeUp 0.9s ease both;
    animation-delay: 0.15s;
  }

  .card-spread {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  /* ── CARD ── */
  .exp-card {
    --card-size: clamp(180px, 19vw, 280px);
    position: absolute;
    width: var(--card-size);
    min-height: var(--card-size);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
    border: 1px solid #e0dfdf;
    border-radius: 8px;
    padding: clamp(16px, 1.8vw, 28px);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    transform: rotate(var(--rot, 0deg));
    transform-origin: center center;
    transition:
      transform 0.35s cubic-bezier(0.34, 1.2, 0.64, 1),
      box-shadow 0.35s ease,
      filter 0.35s ease,
      opacity 0.35s ease;
    z-index: 1;
    user-select: none;
    outline: none;
  }

  .exp-card:focus-visible {
    outline: 2px solid #C9A96E;
    outline-offset: 3px;
  }

  .exp-card:hover:not(.active) {
    transform: rotate(var(--hover-rot, 0deg)) translateY(-8px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.32);
  }

  .exp-card.active {
    transform: translate(var(--active-tx, 0px), var(--active-ty, 0px)) rotate(0deg) scale(1.04);
    box-shadow: 0 20px 56px rgba(0, 0, 0, 0.35);
    z-index: 10;
  }

  .card-spread.has-active .exp-card:not(.active) {
    transform: rotate(var(--rot, 0deg)) scale(0.95);
    filter: blur(3px) brightness(0.55);
    pointer-events: none;
  }

  /* ── CARD INTRO ── */
  .card-intro {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(11px, 1.1vw, 15px);
    color: #C9A96E;
    margin: 0 0 6px 0;
    font-style: italic;
    letter-spacing: 0;
  }

  .is-placeholder .card-intro {
    display: none;
  }

  /* ── HEADLINE ── */
  .card-headline {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(14px, 1.6vw, 22px);
    line-height: 1.25;
    color: #2b2b2b;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .is-placeholder .card-headline {
    color: #c8c4c0;
    font-size: clamp(10px, 1vw, 14px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
  }

  /* ── DETAIL ── */
  .card-detail {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.4s ease, opacity 0.3s ease 0.06s;
  }

  .exp-card.active .card-detail {
    max-height: 600px;
    opacity: 1;
  }

  .card-detail-text {
    font-family: var(--font-sans);
    font-size: clamp(12px, 1.15vw, 15px);
    line-height: 1.65;
    color: #595959;
    margin: 14px 0 0 0;
  }

  .card-oven {
    font-family: var(--font-sans);
    font-size: clamp(12px, 1.15vw, 15px);
    line-height: 1.65;
    color: #bbb;
    font-style: italic;
    margin: 12px 0 0 0;
  }

  .card-link {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #2b2b2b;
    text-decoration: none;
    border-bottom: 1px solid rgba(43, 43, 43, 0.25);
    padding-bottom: 1px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .card-link:hover {
    color: #000;
    border-color: #000;
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    html, body {
      overflow: auto;
      height: auto;
    }

    .experiments-stage {
      height: auto;
      padding-top: 80px;
      padding-bottom: 48px;
      overflow: visible;
    }

    .stage-label {
      padding: 20px 24px 8px;
    }

    .card-spread {
      position: static;
      overflow: visible;
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 20px 24px;
    }

    .exp-card {
      position: static !important;
      width: 100% !important;
      transform: none !important;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }

    .exp-card:hover:not(.active) {
      transform: translateY(-2px) !important;
    }

    .exp-card.active {
      transform: none !important;
    }

    .card-spread.has-active .exp-card:not(.active) {
      transform: none !important;
      filter: none;
      opacity: 0.5;
    }

    .is-placeholder {
      display: none;
    }
  }
</style>

<script>
  const spread = document.getElementById('card-spread')!;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.exp-card'));

  // ── POSITION SHUFFLE ──
  // Extract each card's layout props (with its original row band), shuffle them,
  // then re-apply so real experiments land in a different slot every page load.
  const positions = cards.map((card, i) => ({
    top:      card.style.top,
    left:     card.style.left,
    rot:      card.style.getPropertyValue('--rot'),
    hoverRot: card.style.getPropertyValue('--hover-rot'),
    row:      Math.floor(i / 5) as 0 | 1 | 2,
  }));
  for (let i = positions.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [positions[i], positions[j]] = [positions[j], positions[i]];
  }
  cards.forEach((card, i) => {
    const pos = positions[i];
    card.style.top  = pos.top;
    card.style.left = pos.left;
    card.style.setProperty('--rot',       pos.rot);
    card.style.setProperty('--hover-rot', pos.hoverRot);
    card.dataset.row = String(pos.row);
  });

  // Entrance animation via WAAPI — avoids CSS-var-in-keyframe resolution issues.
  // Cards start off-screen by exactly enough to be hidden, so they're visible
  // for most of the journey and the rotation is clearly perceptible.
  const vw = document.documentElement.clientWidth;
  const vh = document.documentElement.clientHeight;

  cards.forEach(card => {
    const restDeg = parseFloat(card.style.getPropertyValue('--rot') || '0');
    const edges = ['left', 'right', 'top', 'bottom'] as const;
    const edge = edges[Math.floor(Math.random() * 4)];
    const extra = 80 + Math.random() * 30; // 80–110deg rotation swing — visible even near the end of travel

    let tx: number, ty: number, startRot: number;
    if (edge === 'left') {
      tx = -1.3 * vw; ty = 0; startRot = restDeg - extra;
    } else if (edge === 'right') {
      tx =  1.3 * vw; ty = 0; startRot = restDeg + extra;
    } else if (edge === 'top') {
      tx = 0; ty = -1.3 * vh; startRot = restDeg + (Math.random() > 0.5 ? extra : -extra);
    } else {
      tx = 0; ty =  1.3 * vh; startRot = restDeg + (Math.random() > 0.5 ? extra : -extra);
    }

    const delay = Math.random() * 200;        // 0–200ms stagger (was 0–500ms)
    const dur   = 450 + Math.random() * 150;  // 450–600ms duration (was 650–850ms)

    const anim = card.animate(
      [
        { transform: `translate(${tx}px, ${ty}px) rotate(${startRot}deg)`, opacity: '0' },
        { transform: `rotate(${restDeg}deg)`,                              opacity: '1' },
      ],
      { duration: dur, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' }
    );

    anim.addEventListener('finish', () => {
      anim.commitStyles();
      anim.cancel();
      card.style.transform = '';
      card.style.opacity = '';
    }, { once: true });
  });

  // ── Z-INDEX (row-banded, using shuffled row assignment) ──
  // Row 0 (top): z 11–15, Row 1 (middle): z 6–10, Row 2 (bottom): z 1–5.
  const zPools: number[][] = [[], [], []];
  for (let row = 0; row < 3; row++) {
    const base = (2 - row) * 5;
    const band = [base + 1, base + 2, base + 3, base + 4, base + 5];
    for (let i = band.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [band[i], band[j]] = [band[j], band[i]];
    }
    zPools[row] = band;
  }
  const zCounts = [0, 0, 0];
  cards.forEach(card => {
    const row = parseInt(card.dataset.row || '0');
    const z = String(zPools[row][zCounts[row]++]);
    card.style.zIndex = z;
    card.dataset.baseZ = z;
  });

  // Hover: bring card to top, restore on leave
  cards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      if (!card.classList.contains('active')) {
        card.dataset.prevZ = card.style.zIndex;
        card.style.zIndex = '50';
      }
    });
    card.addEventListener('mouseleave', () => {
      if (!card.classList.contains('active') && card.dataset.prevZ) {
        card.style.zIndex = card.dataset.prevZ;
      }
    });
  });
  let activeIndex: number | null = null;
  let topZ = 20;

  function selectCard(index: number) {
    const activeCard = cards[index];

    // Pre-compute viewport correction accounting for full expanded height.
    // The card grows downward from rect.top, so we use the expanded center, not the collapsed center.
    // scrollHeight gives the detail's true height even while collapsed (overflow:hidden doesn't affect it).
    const rect = activeCard.getBoundingClientRect();
    const detail = activeCard.querySelector<HTMLElement>('.card-detail');
    const detailH = detail ? detail.scrollHeight : 0;
    const expandedH = rect.height + detailH;
    const scale = 1.04;
    const cx = rect.left + rect.width / 2;
    const expandedCy = rect.top + expandedH / 2;
    const projLeft   = cx         - (rect.width * scale) / 2;
    const projRight  = cx         + (rect.width * scale) / 2;
    const projTop    = expandedCy - (expandedH  * scale) / 2;
    const projBottom = expandedCy + (expandedH  * scale) / 2;
    const margin = 20;
    let tx = 0, ty = 0;
    if (projLeft   < margin)           tx = margin - projLeft;
    else if (projRight  > vw - margin) tx = (vw - margin) - projRight;
    if (projTop    < margin)           ty = margin - projTop;
    else if (projBottom > vh - margin) ty = (vh - margin) - projBottom;
    activeCard.style.setProperty('--active-tx', `${tx}px`);
    activeCard.style.setProperty('--active-ty', `${ty}px`);

    cards.forEach((card, i) => {
      const isActive = i === index;
      card.classList.toggle('active', isActive);
      card.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      const detail = card.querySelector('.card-detail');
      if (detail) detail.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      card.style.zIndex = isActive ? '100' : (card.dataset.baseZ ?? '1');
    });
    spread.classList.add('has-active');
    activeIndex = index;
  }

  function deselect() {
    cards.forEach(card => {
      card.classList.remove('active');
      card.setAttribute('aria-expanded', 'false');
      const detail = card.querySelector('.card-detail');
      if (detail) detail.setAttribute('aria-hidden', 'true');
      if (card.classList.contains('active')) {
        card.style.zIndex = String(++topZ);
      }
    });
    spread.classList.remove('has-active');
    activeIndex = null;
  }

  cards.forEach((card, i) => {
    card.addEventListener('click', (e) => {
      e.stopPropagation();
      if (activeIndex === i) {
        deselect();
      } else {
        selectCard(i);
      }
    });

    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (activeIndex === i) {
          deselect();
        } else {
          selectCard(i);
        }
      }
    });
  });

  document.addEventListener('click', () => {
    if (activeIndex !== null) deselect();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      deselect();
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      const next = activeIndex === null ? 0 : (activeIndex + 1) % cards.length;
      selectCard(next);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      const next = activeIndex === null ? cards.length - 1 : (activeIndex - 1 + cards.length) % cards.length;
      selectCard(next);
    }
  });
</script>
