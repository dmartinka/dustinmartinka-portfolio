---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const experiments = (await getCollection('experiments')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Experiments — Dustin Martinka"
      description="Things I've built, tried, and learned from. Part playground, part proof of work."
    />
  </head>
  <body>
    <Header forceScrolled={true} />

    <div class="page-hero">
      <div class="page-hero-inner">
        <h1>Experiments</h1>
        <p>I view life as one big experiment. These are things I've built, tried, and learned from. Not all of them worked. That's the point.</p>
      </div>
    </div>

    <main class="wide">
      <ul class="experiments-list">
        {experiments.map((exp) => (
          <li>
            <a href={`/experiments/${exp.id}/`} class="experiment-card">
              {exp.data.image && (
                <div class="card-image">
                  <img src={exp.data.image} alt={exp.data.title} />
                </div>
              )}
              <div class="card-body">
                {exp.data.tags && exp.data.tags.length > 0 && (
                  <div class="card-meta">
                    <div class="tags">
                      {exp.data.tags.map(tag => <span class="tag">{tag}</span>)}
                    </div>
                  </div>
                )}
                <h2 class="card-title">{exp.data.title}</h2>
                <p class="card-description">{exp.data.description}</p>
                <span class="card-link">Read more →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    background: var(--color-beige);
  }

  /* ── HERO ── */
  .page-hero {
    background: #201e1b;
    padding: 120px 56px 72px;
  }

  .page-hero-inner {
    max-width: var(--width-wide);
    margin: 0 auto;
  }

  .page-hero h1 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(48px, 6vw, 80px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #f2ede8;
    margin: 0 0 20px 0;
  }

  .page-hero p {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: rgba(242, 237, 232, 0.5);
    margin: 0;
  }

  /* ── GRID ── */
  main {
    max-width: 1200px;
    width: calc(100% - 112px);
    margin: 0 auto;
    padding: 80px 0;
  }

  .experiments-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  /* ── CARD ── */
  .experiment-card {
    display: block;
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    border: 1px solid #e0dfdf;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .experiment-card:hover {
    box-shadow: 0 8px 24px rgba(43, 43, 43, 0.1);
    transform: translateY(-2px);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: #F5F4F0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 28px 28px 32px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #767676;
  }

  .tag + .tag::before {
    content: '·';
    margin-right: 8px;
    color: rgba(43, 43, 43, 0.2);
  }

  .card-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-black);
    margin: 0 0 10px 0;
  }

  .card-description {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.6;
    color: #595959;
    margin: 0 0 20px 0;
  }

  .card-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-dark);
    text-decoration: none;
  }

  .experiment-card:hover .card-link {
    color: var(--color-black);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 720px) {
    .experiments-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    main {
      width: calc(100% - 64px);
      padding: 56px 0;
    }

    .page-hero {
      padding: 100px 32px 56px;
    }

    .experiments-list {
      grid-template-columns: 1fr;
    }
  }
</style>
