---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';

const PASSWORD_HASH = 'd405e342c33ea8e0e1e65c2d94e5e8eeb8329e4d15fa6a7627de3e47f6cf1406';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="T-Life Redesign — Dustin Martinka"
      description="How I led a 35-person team through a flagship app redesign — 5 product surfaces, many headwinds, and a SUS score that moved from Good to Excellent."
    />
  </head>
  <body>

    <div class="bg-layer" aria-hidden="true">
      <div class="bg-orbs">
        <div class="orb orb-a"></div>
        <div class="orb orb-b"></div>
        <div class="orb orb-c"></div>
      </div>
      <div class="bg-grain"></div>
    </div>

    <Header forceScrolled={true} />

    <!-- ── PASSWORD GATE ── -->
    <div class="gate" id="gate">
      <div class="gate-inner">
        <svg class="gate-lock" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <p class="gate-label">This case study is password protected.</p>
        <form class="gate-form" id="gate-form" autocomplete="off">
          <input class="gate-input" id="gate-input" type="password" placeholder="Enter password" aria-label="Case study password" autocomplete="current-password" />
          <button class="gate-btn" type="submit">View case study</button>
        </form>
        <p class="gate-error" id="gate-error" aria-live="polite"></p>
        <p class="gate-hint">Don't have the password? <a href="mailto:dmartinka@gmail.com">Request access →</a></p>
      </div>
    </div>

    <!-- ── CONTENT ── -->
    <div class="cs-content" id="cs-content">

      <div class="back-wrap">
        <div class="page-container">
          <a class="back-link" href="/work" id="back-btn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            All work
          </a>
        </div>
      </div>

      <!-- HERO -->
      <section class="hero">
        <div class="page-container hero-inner">
          <p class="eyebrow">Case Study · T-Mobile · Confidential</p>
          <h1 class="hero-headline">
            Led the account and eCommerce<br>
            redesign that shipped in <em>T-Life.</em>
          </h1>
          <div class="meta-strip">
            <div class="meta-item">
              <p class="meta-label">Role</p>
              <p class="meta-value">Sr. Manager, Product Design</p>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <p class="meta-label">Team</p>
              <p class="meta-value">35 designers</p>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <p class="meta-label">Year</p>
              <p class="meta-value">2022–2023</p>
            </div>
          </div>
        </div>
      </section>

      <!-- THE SITUATION -->
      <section class="section section--light">
        <div class="section-inner two-col">
          <div class="col-left">
            <h2 class="section-heading">The Situation</h2>
            <p class="body-text">T-Mobile's flagship app was customers' top touchpoint and the business's lowest priority. In a six-month span, only one major feature had shipped. The app was fragmented, under-invested, and no one had made it a design priority.</p>
            <p class="body-text">Leading a team of 35, I took on the redesign with a single hero mission and many simultaneous headwinds.</p>
          </div>
          <div class="col-right">
            <div class="objective-box">
              <p class="objective-label">The mission</p>
              <p class="objective-quote">"Enable customers to do everything our frontline teams can — from a single app."</p>
            </div>
            <div class="headwinds">
              <p class="headwinds-label">What made this hard</p>
              <div class="headwinds-grid">
                <span>Tight timelines</span>
                <span>Lost the director</span>
                <span>No app designers</span>
                <span>Limited VP trust</span>
                <span>Limited budget</span>
                <span>New dev team</span>
                <span>Design system in progress</span>
                <span>Lost 4 designers mid-project</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- THE WORK -->
      <section class="section section--dark">
        <div class="section-inner">
          <p class="section-eyebrow">The work</p>
          <h2 class="section-heading-dark">Five surfaces. One cohesive system.</h2>
          <p class="body-text body-text--muted body-text--centered">The team owned end-to-end design across five product areas — each with its own roadmap, stakeholders, and complexity.</p>
          <div class="surfaces-grid">
            <div class="surface">
              <p class="surface-name">eCommerce</p>
              <p class="surface-items">Upgrades · Add a line · Trade-in · Promotions · Plans</p>
            </div>
            <div class="surface">
              <p class="surface-name">Switch</p>
              <p class="surface-items">Network pass · EasySwitch</p>
            </div>
            <div class="surface">
              <p class="surface-name">Payments &amp; Billing</p>
              <p class="surface-items">One-time payment · AutoPay · Bill presentment · Usage</p>
            </div>
            <div class="surface">
              <p class="surface-name">Account</p>
              <p class="surface-items">Change plan · Manage add-ons · Settings · Benefits</p>
            </div>
            <div class="surface">
              <p class="surface-name">Core</p>
              <p class="surface-items">Sign up &amp; login · Network auth · Search &amp; support · Onboarding</p>
            </div>
          </div>
        </div>
      </section>

      <!-- VISUALS -->
      <section class="section section--light">
        <div class="section-inner">
          <p class="section-eyebrow-light">Selected screens</p>
          <h2 class="section-heading">The account management redesign.</h2>
          <p class="body-text" style="margin-bottom: 40px;">The account surface was the most complex — highest traffic, most fragmented, most stakeholder-contested. What shipped became the foundation for the T-Life account experience.</p>
          <div class="visuals-grid">
            <div class="visual-slot">
              <img src="/work/flagship/flagship-home.png" alt="T-Life account home" />
            </div>
            <div class="visual-slot">
              <img src="/work/flagship/flagship-account.png" alt="T-Life account management" />
            </div>
            <div class="visual-slot">
              <img src="/work/flagship/flagship-support.png" alt="T-Life support" />
            </div>
          </div>
        </div>
      </section>

      <!-- PULL QUOTE -->
      <section class="quote-section">
        <div class="quote-inner">
          <blockquote class="pull-quote">
            "Thirty-five designers. Five product surfaces. Every headwind you could imagine. The work still proved itself."
          </blockquote>
        </div>
      </section>

      <!-- KEY RESULTS -->
      <section class="section section--light">
        <div class="section-inner">
          <h2 class="results-heading">Key Results</h2>
          <p class="results-subhead">Despite a fragmented launch, the work moved the needle where it shipped.</p>
          <div class="results-grid">
            <div class="result-item">
              <p class="result-num">5.5<span class="result-arrow">→</span>6.0</p>
              <p class="result-label">SUS score — from "Good" to "Excellent" across account management testing rounds</p>
            </div>
            <div class="result-item">
              <p class="result-num">+12%</p>
              <p class="result-label">upper funnel lift for phone upgrades from UX improvements</p>
            </div>
            <div class="result-item">
              <p class="result-num">5</p>
              <p class="result-label">product surfaces redesigned end-to-end by a 35-person team</p>
            </div>
          </div>
        </div>
      </section>

      <!-- NEXT PROJECT -->
      <section class="next-section">
        <div class="next-inner">
          <p class="next-label">Next project</p>
          <h2 class="next-headline">Redesigned home search for millions of buyers.</h2>
          <a class="next-cta" href="/work/moxiworks-search">View case study →</a>
        </div>
      </section>

    </div>

  </body>
</html>

<script define:vars={{ PASSWORD_HASH }} is:inline>
  const STORAGE_KEY = 'tlife-auth';

  async function hashPassword(pw) {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pw));
    return Array.from(new Uint8Array(buf)).map(n => n.toString(16).padStart(2, '0')).join('');
  }

  function unlock() {
    const gate    = document.getElementById('gate');
    const content = document.getElementById('cs-content');
    if (gate)    gate.style.display = 'none';
    if (content) { content.style.display = 'block'; }
  }

  function init() {
    if (sessionStorage.getItem(STORAGE_KEY) === 'true') { unlock(); return; }

    const form  = document.getElementById('gate-form');
    const input = document.getElementById('gate-input');
    const error = document.getElementById('gate-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const hash = await hashPassword(input.value.trim());
      if (hash === PASSWORD_HASH) {
        sessionStorage.setItem(STORAGE_KEY, 'true');
        unlock();
      } else {
        error.textContent = 'Incorrect password. Try again or request access below.';
        input.value = '';
        input.focus();
      }
    });

    const backBtn = document.getElementById('back-btn');
    backBtn?.addEventListener('click', (e) => {
      if (document.referrer.startsWith(window.location.origin)) {
        e.preventDefault();
        history.back();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  body { background: #201e1b; overflow-x: hidden; }

  .bg-layer { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
  .bg-orbs  { position: absolute; inset: 0; }
  .bg-grain { position: absolute; inset: 0; mix-blend-mode: overlay; opacity: 0.22; background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/></filter><rect width='300' height='300' filter='url(%23n)' opacity='1'/></svg>"); background-size: 300px 300px; }

  @keyframes pulse-a { from { opacity: 0.1; transform: scale(1); } to { opacity: 0.6; transform: scale(1.1); } }
  @keyframes pulse-b { from { opacity: 0.05; transform: scale(1); } to { opacity: 0.45; transform: scale(1.12); } }
  .orb { position: absolute; border-radius: 50%; mix-blend-mode: screen; }
  .orb-a { width: 600px; height: 600px; top: -100px; left: -100px; background: rgba(201,169,110,0.18); filter: blur(80px); animation: pulse-a 6s ease-in-out infinite alternate; }
  .orb-b { width: 500px; height: 500px; top: 40%; right: -80px; background: rgba(242,237,232,0.08); filter: blur(80px); animation: pulse-b 8s ease-in-out infinite alternate; }
  .orb-c { width: 400px; height: 400px; bottom: 10%; left: 20%; background: rgba(201,169,110,0.1); filter: blur(100px); animation: pulse-a 7s ease-in-out infinite alternate; animation-delay: 2s; }

  /* ── GATE ── */
  .gate { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 24px; background: #201e1b; }
  .gate-inner { display: flex; flex-direction: column; align-items: center; gap: 20px; max-width: 400px; width: 100%; text-align: center; }
  .gate-lock { color: rgba(242,237,232,0.3); }
  .gate-label { font-family: var(--font-sans); font-size: 15px; color: rgba(242,237,232,0.6); margin: 0; }
  .gate-form { display: flex; flex-direction: column; gap: 10px; width: 100%; }
  .gate-input { width: 100%; padding: 12px 16px; font-family: var(--font-sans); font-size: 15px; background: rgba(242,237,232,0.06); border: 1px solid rgba(242,237,232,0.12); border-radius: 8px; color: #f2ede8; outline: none; box-sizing: border-box; transition: border-color 0.2s ease; }
  .gate-input:focus { border-color: rgba(201,169,110,0.5); }
  .gate-input::placeholder { color: rgba(242,237,232,0.25); }
  .gate-btn { padding: 12px 24px; font-family: var(--font-sans); font-size: 14px; font-weight: 500; background: #C9A96E; color: #1a1411; border: none; border-radius: 8px; cursor: pointer; transition: background 0.2s ease; }
  .gate-btn:hover { background: #d9bc89; }
  .gate-error { font-family: var(--font-sans); font-size: 13px; color: rgba(220,100,80,0.85); margin: 0; min-height: 18px; }
  .gate-hint { font-family: var(--font-sans); font-size: 12px; color: rgba(242,237,232,0.25); margin: 0; }
  .gate-hint a { color: rgba(201,169,110,0.6); text-decoration: none; }
  .gate-hint a:hover { color: #C9A96E; }

  /* ── CONTENT ── */
  .cs-content { display: none; }
  .page-container { max-width: 1080px; margin: 0 auto; }

  .back-wrap { position: relative; z-index: 10; padding: 104px clamp(28px, 8vw, 120px) 0; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(242,237,232,0.4); text-decoration: none; transition: color 0.2s ease; }
  .back-link:hover { color: #C9A96E; }

  /* ── HERO ── */
  .hero { position: relative; z-index: 10; padding: clamp(32px, 5vh, 56px) clamp(28px, 8vw, 120px) clamp(64px, 10vh, 120px); }
  .hero-inner { max-width: 1080px; margin: 0 auto; }
  .eyebrow { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #C9A96E; margin: 0 0 24px; }
  .hero-headline { font-family: var(--font-serif); font-weight: 300; font-size: clamp(36px, 5.5vw, 72px); line-height: 1.1; letter-spacing: -0.025em; color: #f2ede8; margin: 0 0 48px; max-width: 860px; }
  .hero-headline em { font-style: italic; color: #C9A96E; }
  .meta-strip { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }
  .meta-item { display: flex; flex-direction: column; gap: 4px; }
  .meta-label { font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(242,237,232,0.35); margin: 0; }
  .meta-value { font-family: var(--font-sans); font-size: 14px; color: rgba(242,237,232,0.75); margin: 0; }
  .meta-divider { width: 1px; height: 32px; background: rgba(242,237,232,0.12); }

  /* ── SECTIONS ── */
  .section { position: relative; z-index: 10; padding: clamp(64px, 10vh, 120px) clamp(28px, 8vw, 120px); }
  .section--light { background: #f2ede8; }
  .section--dark  { background: #1a1815; }
  .section-inner  { max-width: 1080px; margin: 0 auto; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }

  .section-eyebrow { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #C9A96E; margin: 0 0 16px; }
  .section-eyebrow-light { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(43,43,43,0.4); margin: 0 0 16px; }
  .section-heading { font-family: var(--font-serif); font-weight: 300; font-size: clamp(28px, 3.5vw, 48px); line-height: 1.15; letter-spacing: -0.02em; color: #2b2b2b; margin: 0 0 24px; }
  .section-heading-dark { font-family: var(--font-serif); font-weight: 300; font-size: clamp(28px, 3.5vw, 48px); line-height: 1.15; letter-spacing: -0.02em; color: #f2ede8; margin: 0 0 16px; text-align: center; }

  .body-text { font-family: var(--font-sans); font-size: clamp(15px, 1.2vw, 17px); line-height: 1.75; color: #595959; margin: 0 0 18px; }
  .body-text:last-child { margin-bottom: 0; }
  .body-text--muted { color: rgba(242,237,232,0.5); }
  .body-text--centered { text-align: center; max-width: 600px; margin: 0 auto 48px; }

  /* ── OBJECTIVE BOX ── */
  .objective-box { background: #2b2b2b; border-radius: 10px; padding: 28px 32px; margin-bottom: 24px; }
  .objective-label { font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #C9A96E; margin: 0 0 12px; }
  .objective-quote { font-family: var(--font-serif); font-style: italic; font-size: clamp(15px, 1.3vw, 19px); line-height: 1.55; color: #f2ede8; margin: 0; }

  /* ── HEADWINDS ── */
  .headwinds { }
  .headwinds-label { font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(43,43,43,0.38); margin: 0 0 12px; }
  .headwinds-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .headwinds-grid span { font-family: var(--font-sans); font-size: 12px; font-weight: 400; color: rgba(43,43,43,0.6); background: rgba(43,43,43,0.07); border-radius: 4px; padding: 5px 10px; }

  /* ── SURFACES GRID ── */
  .surfaces-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px; border-radius: 10px; overflow: hidden; }
  .surface { background: rgba(242,237,232,0.04); border: 1px solid rgba(242,237,232,0.08); padding: 24px 20px; }
  .surface-name { font-family: var(--font-sans); font-size: 13px; font-weight: 600; color: #C9A96E; margin: 0 0 10px; }
  .surface-items { font-family: var(--font-sans); font-size: 12px; line-height: 1.7; color: rgba(242,237,232,0.35); margin: 0; }

  /* ── VISUALS ── */
  .visuals-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .visual-slot { border-radius: 10px; overflow: hidden; }
  .visual-slot img { width: 100%; height: auto; display: block; border-radius: 10px; }

  /* ── PULL QUOTE ── */
  .quote-section { position: relative; z-index: 10; background: #201e1b; padding: clamp(64px, 10vh, 120px) clamp(28px, 8vw, 120px); border-top: 1px solid rgba(242,237,232,0.06); border-bottom: 1px solid rgba(242,237,232,0.06); }
  .quote-inner { max-width: 800px; margin: 0 auto; }
  .pull-quote { font-family: var(--font-serif); font-style: italic; font-weight: 300; font-size: clamp(24px, 3.5vw, 44px); line-height: 1.35; letter-spacing: -0.015em; color: #f2ede8; margin: 0; border-left: 3px solid #C9A96E; padding-left: clamp(24px, 3vw, 48px); }

  /* ── KEY RESULTS ── */
  .results-heading { font-family: var(--font-serif); font-weight: 300; font-size: clamp(28px, 3.5vw, 48px); letter-spacing: -0.02em; color: #2b2b2b; margin: 0 0 8px; text-align: center; }
  .results-subhead { font-family: var(--font-sans); font-size: 14px; color: rgba(43,43,43,0.45); text-align: center; margin: 0 0 56px; }
  .results-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; border-radius: 10px; overflow: hidden; }
  .result-item { background: #ede8e1; padding: clamp(32px, 4vw, 56px) clamp(24px, 3vw, 40px); text-align: center; }
  .result-num { font-family: var(--font-sans); font-weight: 700; font-size: clamp(32px, 4.5vw, 60px); line-height: 1; letter-spacing: -0.04em; color: #2b2b2b; margin: 0 0 12px; }
  .result-arrow { font-weight: 300; color: #C9A96E; margin: 0 4px; }
  .result-label { font-family: var(--font-sans); font-size: 13px; line-height: 1.55; color: rgba(43,43,43,0.5); margin: 0 auto; max-width: 200px; }

  /* ── NEXT ── */
  .next-section { position: relative; z-index: 10; background: #171512; padding: clamp(64px, 10vh, 120px) clamp(28px, 8vw, 120px); }
  .next-inner { max-width: 1080px; margin: 0 auto; }
  .next-label { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(242,237,232,0.3); margin: 0 0 16px; }
  .next-headline { font-family: var(--font-serif); font-weight: 300; font-size: clamp(24px, 3.5vw, 48px); line-height: 1.15; letter-spacing: -0.02em; color: #f2ede8; margin: 0 0 32px; max-width: 600px; }
  .next-cta { font-family: var(--font-sans); font-size: 14px; font-weight: 500; color: #C9A96E; text-decoration: none; border-bottom: 1px solid rgba(201,169,110,0.35); padding-bottom: 2px; transition: color 0.2s ease, border-color 0.2s ease; }
  .next-cta:hover { color: #d9bc89; border-color: rgba(201,169,110,0.7); }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .two-col { grid-template-columns: 1fr; }
    .surfaces-grid { grid-template-columns: repeat(2, 1fr); }
    .visuals-grid { grid-template-columns: 1fr; }
    .results-grid { grid-template-columns: 1fr; }
    .meta-strip { gap: 20px; }
    .meta-divider { display: none; }
  }

  @media (max-width: 480px) {
    .surfaces-grid { grid-template-columns: 1fr; }
  }
</style>
