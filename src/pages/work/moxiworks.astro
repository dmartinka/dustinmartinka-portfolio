---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="MoxiWorks — Dustin Martinka"
      description="How I built UX from the ground up at a real estate SaaS company — a design system, a research practice, a team, and a seat at the table."
    />
  </head>
  <body>

    <div class="bg-layer" aria-hidden="true">
      <div class="bg-orbs">
        <div class="orb orb-a"></div>
        <div class="orb orb-b"></div>
        <div class="orb orb-c"></div>
      </div>
      <div class="bg-grain"></div>
    </div>

    <Header forceScrolled={true} />

    <div class="cs-content" id="cs-content">

      <!-- BACK LINK -->
      <div class="back-wrap">
        <div class="page-container">
          <a class="back-link" href="/work" id="back-btn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            All work
          </a>
        </div>
      </div>

      <!-- HERO -->
      <section class="hero">
        <div class="page-container hero-inner">
          <p class="eyebrow">Case Study · MoxiWorks · 2015–2021</p>
          <h1 class="hero-headline">
            I was the <em>only designer.</em><br>
            Here's what I left behind.
          </h1>
          <div class="meta-strip">
            <div class="meta-item">
              <p class="meta-label">Role</p>
              <p class="meta-value">Head of Design</p>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <p class="meta-label">Team built</p>
              <p class="meta-value">1 → 4 designers</p>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <p class="meta-label">Tenure</p>
              <p class="meta-value">6 years</p>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <p class="meta-label">Products</p>
              <p class="meta-value">4 SaaS products</p>
            </div>
          </div>
        </div>
      </section>

      <!-- THE SITUATION -->
      <section class="section section--light">
        <div class="section-inner two-col">
          <div class="col-left">
            <h2 class="section-heading">The Situation</h2>
            <p class="body-text">MoxiWorks was a real estate SaaS company with four products, no UX culture, and no design team. I joined as essentially the only designer — me and one intern, covering all four products.</p>
            <p class="body-text">There was no process, no system, no research practice. Product decisions happened without a design voice at the table. My job wasn't just to design — it was to prove that UX was worth investing in, and then build the thing from the ground up.</p>
          </div>
          <div class="col-right">
            <div class="objective-box">
              <p class="objective-label">The starting point</p>
              <p class="objective-quote">"One designer. One intern. Four products. No playbook."</p>
            </div>
            <div class="approach-items">
              <div class="approach-item">
                <span class="approach-num">1</span>
                <div>
                  <p class="approach-title">Build the team</p>
                  <p class="approach-body">Hire designers who could own products and run research independently.</p>
                </div>
              </div>
              <div class="approach-item">
                <span class="approach-num">2</span>
                <div>
                  <p class="approach-title">Build the practice</p>
                  <p class="approach-body">Earn a seat at the table. Get research into the product process. Create a UX culture.</p>
                </div>
              </div>
              <div class="approach-item">
                <span class="approach-num">3</span>
                <div>
                  <p class="approach-title">Build the system</p>
                  <p class="approach-body">Create the design language that would unify four products and survive long after I left.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- THE TEAM -->
      <section class="section section--dark">
        <div class="section-inner two-col">
          <div class="col-left">
            <p class="section-eyebrow">Building the team</p>
            <h2 class="section-heading-dark">Hired for ownership, not headcount.</h2>
            <p class="body-text body-text--muted">I grew the team from one intern to a Sr. Designer, a mid-level designer, and an intern position — each owning a product end-to-end, not just executing tickets.</p>
            <p class="body-text body-text--muted">Two of the designers came through a UX bootcamp partnership I initiated. I saw it as a way to bring in people who were hungry and didn't have the credentialing bias — and it worked. The team became the tightest-knit group I've been a part of.</p>
            <p class="body-text body-text--muted">I made sure every hire could run research independently. We didn't have a dedicated researcher — so every designer had to be one.</p>
          </div>
          <div class="col-right col-right--stat">
            <div class="team-stat">
              <p class="team-stat-num">1 → 4</p>
              <p class="team-stat-label">designers over 6 years</p>
            </div>
            <div class="team-stat-divider" aria-hidden="true">across</div>
            <div class="team-stat">
              <p class="team-stat-num">4</p>
              <p class="team-stat-label">SaaS products owned</p>
            </div>
          </div>
        </div>
      </section>

      <!-- THE PRACTICE -->
      <section class="section section--light">
        <div class="section-inner">
          <div class="governance-header">
            <p class="section-eyebrow-light">Building the practice</p>
            <h2 class="section-heading">Built a UX culture where there was none.</h2>
          </div>
          <div class="governance-grid">
            <div class="governance-item">
              <p class="governance-title">A seat at the table</p>
              <p class="governance-body">Convinced executives to invest in user research by proving its return on investment. Embedded research into the product development process — and earned a genuine voice in product planning alongside the PM team.</p>
            </div>
            <div class="governance-item">
              <p class="governance-title">Product planning partnership</p>
              <p class="governance-body">Collaborated with product management to run our own planning process — not just fielding requests. Design was shaping what got built, not reacting to it.</p>
            </div>
            <div class="governance-item">
              <p class="governance-title">Design thinking workshop</p>
              <p class="governance-body">Brought the first design thinking workshop to the product team, based on Google Design Sprint methodology. Set the foundation for how we'd solve problems together as a cross-functional group.</p>
            </div>
            <div class="governance-item">
              <p class="governance-title">The UX space</p>
              <p class="governance-body">Advocated to build out a dedicated UX and product space in an unused area of the building. Whiteboarding sessions, workshops, collaboration — a physical signal that design was a real discipline here.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- VITRUVIUS -->
      <section class="section section--dark">
        <div class="section-inner two-col">
          <div class="col-left">
            <p class="section-eyebrow">The design system</p>
            <h2 class="section-heading-dark">Built Vitruvius. It's still in production.</h2>
            <p class="body-text body-text--muted">Vitruvius unified the visual and interaction language across all four MoxiWorks products. I built it in close partnership with Engineering — not as a handoff artifact, but as a shared tool that made both sides faster.</p>
            <p class="body-text body-text--muted">The result was faster development cycles, a more consistent experience across the platform, and a system that outlasted my time there. It's been in production for over 6 years.</p>
          </div>
          <div class="col-right col-right--vision">
            <div class="vision-card">
              <p class="vision-label">What it solved</p>
              <p class="vision-text">Four products with inconsistent patterns, visual language, and interaction models — unified under one system.</p>
            </div>
            <div class="vision-card">
              <p class="vision-label">How we built it</p>
              <p class="vision-text">Partnered directly with Engineering on adoption. It was a shared tool, not a design deliverable.</p>
            </div>
            <div class="vision-card">
              <p class="vision-label">The proof</p>
              <p class="vision-text">Still in production today — more than 6 years after I built it.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CRAFT EVIDENCE -->
      <section class="section section--light">
        <div class="section-inner">
          <p class="section-eyebrow-light">Craft in action</p>
          <h2 class="section-heading">The work still had to ship.</h2>
          <p class="body-text" style="max-width: 640px; margin-bottom: 48px;">Building a practice doesn't mean stepping away from the work. I stayed hands-on as a working designer throughout — running research, designing, and shipping across the platform. One example: a full redesign of the property search experience, from discovery to delivery.</p>
          <div class="metrics-row">
            <div class="metric-item">
              <p class="metric-num">92%</p>
              <p class="metric-label">user satisfaction on the redesigned search experience</p>
            </div>
            <div class="metric-item">
              <p class="metric-num">+36.7%</p>
              <p class="metric-label">mobile pageviews after launch</p>
            </div>
            <div class="metric-item">
              <p class="metric-num">−20.7%</p>
              <p class="metric-label">bounce rate improvement</p>
            </div>
          </div>
        </div>
      </section>

      <!-- PULL QUOTE -->
      <section class="quote-section">
        <div class="quote-inner">
          <blockquote class="pull-quote">
            "I didn't just design at MoxiWorks. I built the conditions for great design to happen — and then did the work."
          </blockquote>
        </div>
      </section>

      <!-- KEY RESULTS -->
      <section class="section section--light">
        <div class="section-inner">
          <h2 class="results-heading">What I left behind</h2>
          <p class="results-subhead">A team, a system, a culture, and metrics that moved.</p>
          <div class="results-grid">
            <div class="result-item">
              <p class="result-num">4</p>
              <p class="result-label">designers hired and developed across 6 years</p>
            </div>
            <div class="result-item">
              <p class="result-num">6+</p>
              <p class="result-label">years Vitruvius has been in production</p>
            </div>
            <div class="result-item">
              <p class="result-num">92%</p>
              <p class="result-label">user satisfaction on search — the flagship craft example</p>
            </div>
          </div>
        </div>
      </section>

      <!-- NEXT PROJECT -->
      <section class="next-section">
        <div class="next-inner">
          <p class="next-label">The craft side of MoxiWorks</p>
          <h2 class="next-headline">Redesigned home search for millions of buyers.</h2>
          <a class="next-cta" href="/work/moxiworks-search">View case study →</a>
        </div>
      </section>

    </div><!-- /cs-content -->

  </body>
</html>

<script is:inline>
  function init() {
    const backBtn = document.getElementById('back-btn');
    backBtn?.addEventListener('click', (e) => {
      if (document.referrer.startsWith(window.location.origin)) {
        e.preventDefault();
        history.back();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  body {
    background: #201e1b;
    overflow-x: hidden;
  }

  /* ── BACKGROUND ── */
  .bg-layer { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
  .bg-orbs  { position: absolute; inset: 0; }
  .bg-grain { position: absolute; inset: 0; mix-blend-mode: overlay; opacity: 0.22; background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/></filter><rect width='300' height='300' filter='url(%23n)' opacity='1'/></svg>"); background-size: 300px 300px; }

  @keyframes pulse-a { from { opacity: 0.1; transform: scale(1); } to { opacity: 0.6; transform: scale(1.1); } }
  @keyframes pulse-b { from { opacity: 0.05; transform: scale(1); } to { opacity: 0.45; transform: scale(1.12); } }
  .orb { position: absolute; border-radius: 50%; mix-blend-mode: screen; }
  .orb-a { width: 600px; height: 600px; top: -100px; left: -100px; background: rgba(201,169,110,0.18); filter: blur(80px); animation: pulse-a 6s ease-in-out infinite alternate; }
  .orb-b { width: 500px; height: 500px; top: 40%; right: -80px; background: rgba(242,237,232,0.08); filter: blur(80px); animation: pulse-b 8s ease-in-out infinite alternate; }
  .orb-c { width: 400px; height: 400px; bottom: 10%; left: 20%; background: rgba(201,169,110,0.1); filter: blur(100px); animation: pulse-a 7s ease-in-out infinite alternate; animation-delay: 2s; }

  /* ── LAYOUT ── */
  .cs-content { display: block; }
  .page-container { max-width: 1080px; margin: 0 auto; }

  .back-wrap { position: relative; z-index: 10; padding: 104px clamp(28px, 8vw, 120px) 0; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(242,237,232,0.4); text-decoration: none; transition: color 0.2s ease; }
  .back-link:hover { color: #C9A96E; }

  /* ── HERO ── */
  .hero { position: relative; z-index: 10; padding: clamp(32px, 5vh, 56px) clamp(28px, 8vw, 120px) clamp(64px, 10vh, 120px); }
  .hero-inner { max-width: 1080px; margin: 0 auto; }
  .eyebrow { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #C9A96E; margin: 0 0 24px; }
  .hero-headline { font-family: var(--font-serif); font-weight: 300; font-size: clamp(36px, 5.5vw, 72px); line-height: 1.1; letter-spacing: -0.025em; color: #f2ede8; margin: 0 0 48px; max-width: 860px; }
  .hero-headline em { font-style: italic; color: #C9A96E; }
  .meta-strip { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }
  .meta-item { display: flex; flex-direction: column; gap: 4px; }
  .meta-label { font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(242,237,232,0.35); margin: 0; }
  .meta-value { font-family: var(--font-sans); font-size: 14px; color: rgba(242,237,232,0.75); margin: 0; }
  .meta-divider { width: 1px; height: 32px; background: rgba(242,237,232,0.12); }

  /* ── SECTIONS ── */
  .section { position: relative; z-index: 10; padding: clamp(64px, 10vh, 120px) clamp(28px, 8vw, 120px); }
  .section--light { background: #f2ede8; }
  .section--dark  { background: #1a1815; }
  .section-inner  { max-width: 1080px; margin: 0 auto; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }

  .section-eyebrow { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #C9A96E; margin: 0 0 16px; }
  .section-eyebrow-light { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(43,43,43,0.4); margin: 0 0 16px; }
  .section-heading { font-family: var(--font-serif); font-weight: 300; font-size: clamp(28px, 3.5vw, 48px); line-height: 1.15; letter-spacing: -0.02em; color: #2b2b2b; margin: 0 0 24px; }
  .section-heading-dark { font-family: var(--font-serif); font-weight: 300; font-size: clamp(24px, 3vw, 42px); line-height: 1.15; letter-spacing: -0.02em; color: #f2ede8; margin: 0 0 24px; }

  .body-text { font-family: var(--font-sans); font-size: clamp(15px, 1.2vw, 17px); line-height: 1.75; color: #595959; margin: 0 0 18px; }
  .body-text:last-child { margin-bottom: 0; }
  .body-text--muted { color: rgba(242,237,232,0.5); }

  /* ── OBJECTIVE BOX ── */
  .objective-box { background: #2b2b2b; border-radius: 10px; padding: 28px 32px; margin-bottom: 32px; }
  .objective-label { font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #C9A96E; margin: 0 0 12px; }
  .objective-quote { font-family: var(--font-serif); font-style: italic; font-size: clamp(15px, 1.3vw, 19px); line-height: 1.55; color: #f2ede8; margin: 0; }

  /* ── APPROACH ITEMS ── */
  .approach-items { display: flex; flex-direction: column; gap: 20px; }
  .approach-item { display: flex; gap: 16px; align-items: flex-start; }
  .approach-num { width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(43,43,43,0.2); display: flex; align-items: center; justify-content: center; font-family: var(--font-sans); font-size: 11px; font-weight: 600; color: rgba(43,43,43,0.5); flex-shrink: 0; }
  .approach-title { font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: #2b2b2b; margin: 0 0 4px; }
  .approach-body { font-family: var(--font-sans); font-size: 14px; line-height: 1.6; color: rgba(43,43,43,0.55); margin: 0; }

  /* ── TEAM STAT ── */
  .col-right--stat { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 48px 32px; background: rgba(242,237,232,0.04); border: 1px solid rgba(242,237,232,0.08); border-radius: 12px; }
  .team-stat { text-align: center; }
  .team-stat-num { font-family: var(--font-sans); font-weight: 600; font-size: clamp(48px, 6vw, 80px); line-height: 1; letter-spacing: -0.04em; color: #f2ede8; margin: 0 0 6px; }
  .team-stat-label { font-family: var(--font-sans); font-size: 11px; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(242,237,232,0.35); margin: 0; }
  .team-stat-divider { font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(242,237,232,0.2); }

  /* ── GOVERNANCE GRID ── */
  .governance-header { margin-bottom: 48px; }
  .governance-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; border-radius: 10px; overflow: hidden; }
  .governance-item { background: #ede8e1; padding: clamp(28px, 3vw, 40px); }
  .governance-title { font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: #2b2b2b; margin: 0 0 10px; }
  .governance-body { font-family: var(--font-sans); font-size: 14px; line-height: 1.65; color: rgba(43,43,43,0.6); margin: 0; }

  /* ── VISION CARDS ── */
  .col-right--vision { display: flex; flex-direction: column; gap: 12px; }
  .vision-card { background: rgba(242,237,232,0.05); border: 1px solid rgba(242,237,232,0.08); border-radius: 8px; padding: 20px 24px; }
  .vision-label { font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #C9A96E; margin: 0 0 8px; }
  .vision-text { font-family: var(--font-sans); font-size: 14px; line-height: 1.6; color: rgba(242,237,232,0.65); margin: 0; }

  /* ── CRAFT METRICS ── */
  .metrics-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; border-radius: 10px; overflow: hidden; }
  .metric-item { background: #ede8e1; padding: clamp(32px, 4vw, 56px) clamp(24px, 3vw, 40px); text-align: center; }
  .metric-num { font-family: var(--font-sans); font-weight: 700; font-size: clamp(36px, 5vw, 64px); line-height: 1; letter-spacing: -0.04em; color: #2b2b2b; margin: 0 0 12px; }
  .metric-label { font-family: var(--font-sans); font-size: 13px; line-height: 1.55; color: rgba(43,43,43,0.5); margin: 0 auto; max-width: 200px; }

  /* ── PULL QUOTE ── */
  .quote-section { position: relative; z-index: 10; background: #201e1b; padding: clamp(64px, 10vh, 120px) clamp(28px, 8vw, 120px); border-top: 1px solid rgba(242,237,232,0.06); border-bottom: 1px solid rgba(242,237,232,0.06); }
  .quote-inner { max-width: 800px; margin: 0 auto; }
  .pull-quote { font-family: var(--font-serif); font-style: italic; font-weight: 300; font-size: clamp(24px, 3.5vw, 44px); line-height: 1.35; letter-spacing: -0.015em; color: #f2ede8; margin: 0; border-left: 3px solid #C9A96E; padding-left: clamp(24px, 3vw, 48px); }

  /* ── KEY RESULTS ── */
  .results-heading { font-family: var(--font-serif); font-weight: 300; font-size: clamp(28px, 3.5vw, 48px); letter-spacing: -0.02em; color: #2b2b2b; margin: 0 0 8px; text-align: center; }
  .results-subhead { font-family: var(--font-sans); font-size: 14px; color: rgba(43,43,43,0.45); text-align: center; margin: 0 0 56px; }
  .results-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; border-radius: 10px; overflow: hidden; }
  .result-item { background: #ede8e1; padding: clamp(32px, 4vw, 56px) clamp(24px, 3vw, 40px); text-align: center; }
  .result-num { font-family: var(--font-sans); font-weight: 700; font-size: clamp(36px, 5vw, 64px); line-height: 1; letter-spacing: -0.04em; color: #2b2b2b; margin: 0 0 12px; }
  .result-label { font-family: var(--font-sans); font-size: 13px; line-height: 1.55; color: rgba(43,43,43,0.5); margin: 0 auto; max-width: 200px; }

  /* ── NEXT PROJECT ── */
  .next-section { position: relative; z-index: 10; background: #171512; padding: clamp(64px, 10vh, 120px) clamp(28px, 8vw, 120px); }
  .next-inner { max-width: 1080px; margin: 0 auto; }
  .next-label { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(242,237,232,0.3); margin: 0 0 16px; }
  .next-headline { font-family: var(--font-serif); font-weight: 300; font-size: clamp(24px, 3.5vw, 48px); line-height: 1.15; letter-spacing: -0.02em; color: #f2ede8; margin: 0 0 32px; max-width: 600px; }
  .next-cta { font-family: var(--font-sans); font-size: 14px; font-weight: 500; color: #C9A96E; text-decoration: none; border-bottom: 1px solid rgba(201,169,110,0.35); padding-bottom: 2px; transition: color 0.2s ease, border-color 0.2s ease; }
  .next-cta:hover { color: #d9bc89; border-color: rgba(201,169,110,0.7); }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .two-col { grid-template-columns: 1fr; }
    .governance-grid { grid-template-columns: 1fr; }
    .metrics-row { grid-template-columns: 1fr; }
    .results-grid { grid-template-columns: 1fr; }
    .meta-strip { gap: 20px; }
    .meta-divider { display: none; }
    .col-right--stat { padding: 32px 24px; }
  }
</style>
