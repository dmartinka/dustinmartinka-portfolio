---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';

const PASSWORD_HASH = 'd405e342c33ea8e0e1e65c2d94e5e8eeb8329e4d15fa6a7627de3e47f6cf1406';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Web Elevation — Dustin Martinka"
      description="How I made the case to own T-Mobile's fragmented web experience, then built the vision that earned design a seat on the t-mobile.com homepage redesign."
    />
  </head>
  <body>

    <div class="bg-layer" aria-hidden="true">
      <div class="bg-orbs">
        <div class="orb orb-a"></div>
        <div class="orb orb-b"></div>
        <div class="orb orb-c"></div>
      </div>
      <div class="bg-grain"></div>
    </div>

    <Header forceScrolled={true} />

    <!-- ── PASSWORD GATE ── -->
    <div class="gate" id="gate" aria-label="Password required">
      <div class="gate-inner">
        <svg class="gate-lock" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <p class="gate-label">This case study is password protected.</p>
        <form class="gate-form" id="gate-form" autocomplete="off">
          <input
            class="gate-input"
            id="gate-input"
            type="password"
            placeholder="Enter password"
            aria-label="Case study password"
            autocomplete="current-password"
          />
          <button class="gate-btn" type="submit">View case study</button>
        </form>
        <p class="gate-error" id="gate-error" aria-live="polite"></p>
        <p class="gate-hint">Don't have the password? <a href="mailto:dmartinka@gmail.com">Request access →</a></p>
      </div>
    </div>

    <!-- ── CONTENT (hidden until unlocked) ── -->
    <div class="cs-content" id="cs-content" aria-hidden="true">

      <!-- BACK LINK -->
      <div class="back-wrap">
        <div class="page-container">
          <a class="back-link" href="/work" id="back-btn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            All work
          </a>
        </div>
      </div>

      <!-- HERO -->
      <section class="hero">
        <div class="page-container hero-inner">
          <p class="eyebrow">Case Study · T-Mobile · Confidential</p>
          <h1 class="hero-headline">
            Made the case to own<br>
            T-Mobile's <em>web experience</em>,<br>
            then set the standard for it.
          </h1>
          <div class="meta-strip">
            <div class="meta-item">
              <p class="meta-label">Role</p>
              <p class="meta-value">Sr. Manager, Product Design</p>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <p class="meta-label">Timeline</p>
              <p class="meta-value">6 months</p>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <p class="meta-label">Year</p>
              <p class="meta-value">2023–2024</p>
            </div>
          </div>
        </div>
      </section>

      <!-- THE SITUATION -->
      <section class="section section--light">
        <div class="section-inner two-col">
          <div class="col-left">
            <h2 class="section-heading">The Situation</h2>
            <p class="body-text">Web was T-Mobile's forgotten surface. The app had all the attention. Web was inconsistent, under-resourced, and nobody owned the quality bar across teams. That had been the state for roughly two years.</p>
            <p class="body-text">Nobody assigned this to me. Several managers, including me, each owned a piece of the web, which meant the fragmentation was everyone's problem and no one's responsibility. I kept bringing evidence of that to my VP until she asked me to take the whole thing on. There was no scope or playbook attached to it, so I built one.</p>
          </div>
          <div class="col-right">
            <div class="objective-box">
              <p class="objective-label">The mandate</p>
              <p class="objective-quote">"Elevate the craft, consistency, and quality of all web design work — ensuring our web presence reflects the strength of our brand."</p>
            </div>
            <div class="approach-items">
              <div class="approach-item">
                <span class="approach-num">1</span>
                <div>
                  <p class="approach-title">Build accountability</p>
                  <p class="approach-body">Rally the right principals to set the bar before asking anyone else to meet it.</p>
                </div>
              </div>
              <div class="approach-item">
                <span class="approach-num">2</span>
                <div>
                  <p class="approach-title">Create standards + governance</p>
                  <p class="approach-body">Give teams a toolkit and a quality bar they could actually work from.</p>
                </div>
              </div>
              <div class="approach-item">
                <span class="approach-num">3</span>
                <div>
                  <p class="approach-title">Define the vision</p>
                  <p class="approach-body">Hire for what web could become — not just what it was.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PART 1: ACCOUNTABILITY -->
      <section class="section section--dark">
        <div class="section-inner two-col">
          <div class="col-left">
            <p class="section-eyebrow">Part one</p>
            <h2 class="section-heading-dark">I rallied the bar raisers before I raised the bar.</h2>
            <p class="body-text body-text--muted">Built a group of 7 principals across 6 teams: Foundations, Design Systems, Commerce, T-Mobile for Business, Frontline/Assisted, and Service.</p>
            <p class="body-text body-text--muted">We ran a weekly web design crit — principal-led, open to all designers across teams. No one had created cross-team accountability on the web surface before. We did.</p>
          </div>
          <div class="col-right col-right--stat">
            <div class="team-stat">
              <p class="team-stat-num">7</p>
              <p class="team-stat-label">principals aligned</p>
            </div>
            <div class="team-stat-divider" aria-hidden="true">across</div>
            <div class="team-stat">
              <p class="team-stat-num">6</p>
              <p class="team-stat-label">product teams</p>
            </div>
          </div>
        </div>
      </section>

      <!-- PART 2: STANDARDS + GOVERNANCE -->
      <section class="section section--light">
        <div class="section-inner">
          <div class="governance-header">
            <p class="section-eyebrow-light">Part two</p>
            <h2 class="section-heading">Built the infrastructure for better web design at scale.</h2>
          </div>
          <div class="governance-grid">
            <div class="governance-item">
              <p class="governance-title">Web Governance role</p>
              <p class="governance-body">Created a new Principal of Web Governance + IA role — owning standards, components, and information architecture across the surface.</p>
            </div>
            <div class="governance-item">
              <p class="governance-title">v1 Web Toolkit</p>
              <p class="governance-body">Shipped within 90 days of kickoff. 15 new and refined components added to the design system. A starter set that gave every team a shared foundation.</p>
            </div>
            <div class="governance-item">
              <p class="governance-title">Responsive standards</p>
              <p class="governance-body">Standardized responsive breakpoints — mobile, tablet, desktop, large desktop — applied to 100% of all new web designs.</p>
            </div>
            <div class="governance-item">
              <p class="governance-title">Global nav redesign</p>
              <p class="governance-body">Built alignment across Business, Product, and Marketing on a navigation system that could scale with new products and AI-driven entry points.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- PART 3: VISION -->
      <section class="section section--dark">
        <div class="section-inner two-col">
          <div class="col-left">
            <p class="section-eyebrow">Part three</p>
            <h2 class="section-heading-dark">Hired a Principal whose only job was to define what T-Mobile web could become.</h2>
            <p class="body-text body-text--muted">Brought in Vidal Men with a specific mandate: define what web could be, not what it was.</p>
            <p class="body-text body-text--muted">Month one: established the web design principles the entire surface should work from. Evolved into a research-grounded, stakeholder-aligned prospect journey vision — used as the north star for future web investments.</p>
          </div>
          <div class="col-right col-right--vision">
            <div class="vision-card">
              <p class="vision-label">The mandate</p>
              <p class="vision-text">Define what T-Mobile web could become.</p>
            </div>
            <div class="vision-card">
              <p class="vision-label">Month one</p>
              <p class="vision-text">Web design principles established for the entire surface.</p>
            </div>
            <div class="vision-card">
              <p class="vision-label">The outcome</p>
              <p class="vision-text">A research-grounded prospect journey vision used as the north star for future investments.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- WHAT IT UNLOCKED -->
      <section class="section section--light">
        <div class="section-inner">
          <p class="section-eyebrow-light">What it unlocked</p>
          <h2 class="section-heading">Six months from an unassigned problem to VP-level momentum.</h2>
          <div class="unlock-grid">
            <div class="unlock-item">
              <p class="unlock-num">01</p>
              <p class="unlock-title">VP attention</p>
              <p class="unlock-body">Vidal's vision work got the attention of my VP — design was no longer just executing, it was leading the conversation.</p>
            </div>
            <div class="unlock-item">
              <p class="unlock-num">02</p>
              <p class="unlock-title">A seat at the table</p>
              <p class="unlock-body">Design earned a seat with Marketing to lead the t-mobile.com homepage redesign. The most visible web surface in the company.</p>
            </div>
            <div class="unlock-item">
              <p class="unlock-num">03</p>
              <p class="unlock-title">The tiger team</p>
              <p class="unlock-body">That led to a formal Web Vision Tiger Team: 6-week sprints, 4 flagship web experiences, weekly VP reviews, multi-brand scope across T-Mobile, Mint, and Metro.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- PULL QUOTE -->
      <section class="quote-section">
        <div class="quote-inner">
          <blockquote class="pull-quote">
            "Web was the forgotten surface. I turned it into the most ambitious design initiative of my T-Mobile tenure."
          </blockquote>
        </div>
      </section>

      <!-- KEY RESULTS -->
      <section class="section section--light">
        <div class="section-inner">
          <h2 class="results-heading">Key Results</h2>
          <p class="results-subhead">Craft, culture, and momentum — in six months.</p>
          <div class="results-grid">
            <div class="result-item">
              <p class="result-num">90</p>
              <p class="result-label">days to ship the v1 Web Toolkit from kickoff</p>
            </div>
            <div class="result-item">
              <p class="result-num">100%</p>
              <p class="result-label">designer participation in weekly cross-team web crits</p>
            </div>
            <div class="result-item">
              <p class="result-num">6 mo</p>
              <p class="result-label">from an unassigned problem to VP involvement and a homepage redesign seat</p>
            </div>
          </div>
        </div>
      </section>

      <!-- NEXT PROJECT -->
      <section class="next-section">
        <div class="next-inner">
          <p class="next-label">Next project</p>
          <h2 class="next-headline">Led the redesign that became T-Life.</h2>
          <a class="next-cta" href="/work">View all work →</a>
        </div>
      </section>

    </div><!-- /cs-content -->

  </body>
</html>

<script define:vars={{ PASSWORD_HASH }} is:inline>
  const STORAGE_KEY = 'we-auth';

  async function hashPassword(pw) {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pw));
    return Array.from(new Uint8Array(buf)).map(n => n.toString(16).padStart(2, '0')).join('');
  }

  function unlock() {
    const gate    = document.getElementById('gate');
    const content = document.getElementById('cs-content');
    if (gate)    { gate.style.display = 'none'; }
    if (content) { content.removeAttribute('aria-hidden'); content.style.display = 'block'; }
  }

  function init() {
    // Already authenticated this session?
    if (sessionStorage.getItem(STORAGE_KEY) === 'true') { unlock(); return; }

    const form  = document.getElementById('gate-form');
    const input = document.getElementById('gate-input');
    const error = document.getElementById('gate-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const hash = await hashPassword(input.value.trim());
      if (hash === PASSWORD_HASH) {
        sessionStorage.setItem(STORAGE_KEY, 'true');
        unlock();
      } else {
        error.textContent = 'Incorrect password. Try again or request access below.';
        input.value = '';
        input.focus();
      }
    });

    // Back button: restore scroll position on /work
    const backBtn = document.getElementById('back-btn');
    backBtn?.addEventListener('click', (e) => {
      if (document.referrer.startsWith(window.location.origin)) {
        e.preventDefault();
        history.back();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  body {
    background: #201e1b;
    overflow-x: hidden;
  }

  /* ── BACKGROUND ── */
  .bg-layer {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .bg-orbs { position: absolute; inset: 0; }

  .bg-grain {
    position: absolute;
    inset: 0;
    mix-blend-mode: overlay;
    opacity: 0.22;
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/></filter><rect width='300' height='300' filter='url(%23n)' opacity='1'/></svg>");
    background-size: 300px 300px;
  }

  @keyframes pulse-a { from { opacity: 0.1; transform: scale(1); } to { opacity: 0.6; transform: scale(1.1); } }
  @keyframes pulse-b { from { opacity: 0.05; transform: scale(1); } to { opacity: 0.45; transform: scale(1.12); } }

  .orb { position: absolute; border-radius: 50%; mix-blend-mode: screen; }
  .orb-a { width: 600px; height: 600px; top: -100px; left: -100px; background: rgba(201,169,110,0.18); filter: blur(80px); animation: pulse-a 6s ease-in-out infinite alternate; }
  .orb-b { width: 500px; height: 500px; top: 40%; right: -80px; background: rgba(242,237,232,0.08); filter: blur(80px); animation: pulse-b 8s ease-in-out infinite alternate; }
  .orb-c { width: 400px; height: 400px; bottom: 10%; left: 20%; background: rgba(201,169,110,0.1); filter: blur(100px); animation: pulse-a 7s ease-in-out infinite alternate; animation-delay: 2s; }

  /* ── PASSWORD GATE ── */
  .gate {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #201e1b;
  }

  .gate-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 400px;
    width: 100%;
    text-align: center;
  }

  .gate-lock {
    color: rgba(242, 237, 232, 0.3);
  }

  .gate-label {
    font-family: var(--font-sans);
    font-size: 15px;
    color: rgba(242, 237, 232, 0.6);
    margin: 0;
  }

  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .gate-input {
    width: 100%;
    padding: 12px 16px;
    font-family: var(--font-sans);
    font-size: 15px;
    background: rgba(242, 237, 232, 0.06);
    border: 1px solid rgba(242, 237, 232, 0.12);
    border-radius: 8px;
    color: #f2ede8;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .gate-input:focus {
    border-color: rgba(201, 169, 110, 0.5);
  }

  .gate-input::placeholder {
    color: rgba(242, 237, 232, 0.25);
  }

  .gate-btn {
    padding: 12px 24px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    background: #C9A96E;
    color: #1a1411;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .gate-btn:hover { background: #d9bc89; }

  .gate-error {
    font-family: var(--font-sans);
    font-size: 13px;
    color: rgba(220, 100, 80, 0.85);
    margin: 0;
    min-height: 18px;
  }

  .gate-hint {
    font-family: var(--font-sans);
    font-size: 12px;
    color: rgba(242, 237, 232, 0.25);
    margin: 0;
  }

  .gate-hint a {
    color: rgba(201, 169, 110, 0.6);
    text-decoration: none;
  }

  .gate-hint a:hover { color: #C9A96E; }

  /* ── CONTENT ── */
  .cs-content { display: none; }

  /* ── LAYOUT ── */
  .page-container { max-width: 1080px; margin: 0 auto; }

  .back-wrap {
    position: relative;
    z-index: 10;
    padding: 104px clamp(28px, 8vw, 120px) 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(242, 237, 232, 0.4);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover { color: #C9A96E; }

  /* ── HERO ── */
  .hero {
    position: relative;
    z-index: 10;
    padding: clamp(32px, 5vh, 56px) clamp(28px, 8vw, 120px) clamp(64px, 10vh, 120px);
  }

  .hero-inner { max-width: 1080px; margin: 0 auto; }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #C9A96E;
    margin: 0 0 24px;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(36px, 5.5vw, 72px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: #f2ede8;
    margin: 0 0 48px;
    max-width: 860px;
  }

  .hero-headline em { font-style: italic; color: #C9A96E; }

  .meta-strip { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }
  .meta-item { display: flex; flex-direction: column; gap: 4px; }
  .meta-label { font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(242, 237, 232, 0.35); margin: 0; }
  .meta-value { font-family: var(--font-sans); font-size: 14px; color: rgba(242, 237, 232, 0.75); margin: 0; }
  .meta-divider { width: 1px; height: 32px; background: rgba(242, 237, 232, 0.12); }

  /* ── SECTIONS ── */
  .section { position: relative; z-index: 10; padding: clamp(64px, 10vh, 120px) clamp(28px, 8vw, 120px); }
  .section--light { background: #f2ede8; }
  .section--dark  { background: #1a1815; }
  .section-inner  { max-width: 1080px; margin: 0 auto; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }

  .section-eyebrow { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #C9A96E; margin: 0 0 16px; }
  .section-eyebrow-light { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(43, 43, 43, 0.4); margin: 0 0 16px; }
  .section-heading { font-family: var(--font-serif); font-weight: 300; font-size: clamp(28px, 3.5vw, 48px); line-height: 1.15; letter-spacing: -0.02em; color: #2b2b2b; margin: 0 0 24px; }
  .section-heading-dark { font-family: var(--font-serif); font-weight: 300; font-size: clamp(24px, 3vw, 42px); line-height: 1.15; letter-spacing: -0.02em; color: #f2ede8; margin: 0 0 24px; }

  .body-text { font-family: var(--font-sans); font-size: clamp(15px, 1.2vw, 17px); line-height: 1.75; color: #595959; margin: 0 0 18px; }
  .body-text:last-child { margin-bottom: 0; }
  .body-text--muted { color: rgba(242, 237, 232, 0.5); }

  /* ── OBJECTIVE BOX ── */
  .objective-box { background: #2b2b2b; border-radius: 10px; padding: 28px 32px; margin-bottom: 32px; }
  .objective-label { font-family: var(--font-sans); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #C9A96E; margin: 0 0 12px; }
  .objective-quote { font-family: var(--font-serif); font-style: italic; font-size: clamp(15px, 1.3vw, 19px); line-height: 1.55; color: #f2ede8; margin: 0; }

  /* ── APPROACH ITEMS ── */
  .approach-items { display: flex; flex-direction: column; gap: 20px; }
