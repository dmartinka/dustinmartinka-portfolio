---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  status?: string;
  tags?: string[];
}

const { title, description, status, tags } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header forceScrolled={true} />

    <div class="experiment-header">
      <div class="experiment-header-inner">
        <a href="/experiments" class="back-link">← Experiments</a>
        <div class="meta">
          {status && <span class="status-badge">{status}</span>}
          {tags && tags.length > 0 && (
            <div class="tags">
              {tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          )}
        </div>
        <h1>{title}</h1>
        <p class="description">{description}</p>
      </div>
    </div>

    <main>
      <div class="prose">
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    background: var(--color-beige);
  }

  /* ── HEADER ── */
  .experiment-header {
    background: #201e1b;
    padding: 120px 56px 72px;
  }

  .experiment-header-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: rgba(242, 237, 232, 0.5);
    text-decoration: none;
    margin-bottom: 32px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: rgba(242, 237, 232, 0.9);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .status-badge {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C9A96E;
    border: 1px solid rgba(201, 169, 110, 0.4);
    padding: 4px 10px;
    border-radius: 20px;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(242, 237, 232, 0.4);
  }

  .tag + .tag::before {
    content: '·';
    margin-right: 8px;
    color: rgba(242, 237, 232, 0.2);
  }

  .experiment-header h1 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #f2ede8;
    margin: 0 0 20px 0;
  }

  .description {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: rgba(242, 237, 232, 0.55);
    margin: 0;
  }

  /* ── PROSE ── */
  main {
    width: var(--width-content);
    max-width: calc(100% - 2rem);
    margin: 0 auto;
    padding: var(--space-16) var(--space-4);
  }

  .prose :global(p) {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.75;
    color: rgba(43, 43, 43, 0.85);
    margin: 0 0 var(--space-6) 0;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-dark);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 720px) {
    .experiment-header {
      padding: 100px 32px 56px;
    }
  }
</style>
